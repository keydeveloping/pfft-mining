# Ethereum RPC endpoint
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional wallet path
# PFFT_WALLET=/workspace/pfft-mining/wallet.json

# Gas limit for mint tx
PFFT_GAS_LIMIT=200000

# Cooldown between rounds
PFFT_PAUSE_BETWEEN_ROUNDS=5

# CUDA binary path
PFFT_CUDA_BINARY=./cuda_keccak_miner

# CUDA tuning
CUDA_GPU_ID=0
CUDA_BLOCK_SIZE=256
CUDA_GRID_SIZE=65536
CUDA_BATCHES=4096

# Build arch examples:
# RTX 5090 -> try sm_120
# If nvcc too old, use supported arch from your toolkit
