# Ethereum RPC endpoint
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional wallet path
# PFFT_WALLET=/workspace/pfft-mining/wallet.json

# Gas limit for mint tx
PFFT_GAS_LIMIT=200000

# Cooldown between rounds (0 = fastest; recommended for racey minting)
PFFT_PAUSE_BETWEEN_ROUNDS=0

# EIP-1559 gas strategy. Raise tip if many reverts due to race.
PFFT_PRIORITY_FEE_GWEI=3
PFFT_MAX_FEE_MULTIPLIER=2
PFFT_MAX_FEE_EXTRA_GWEI=3
PFFT_RECEIPT_TIMEOUT=30
PFFT_STUCK_NONCE_THRESHOLD=2
PFFT_STUCK_FEE_STEP_GWEI=0.5
PFFT_STUCK_MAX_EXTRA_GWEI=5

# Skip stale nonce if challenge changes after GPU solve
PFFT_PRE_SUBMIT_CHALLENGE_CHECK=1

# eth_call before sending tx; avoids paying gas for obvious revert
PFFT_PREFLIGHT_CALL=1

# CUDA binary path
PFFT_CUDA_BINARY=./cuda_keccak_miner

# CUDA tuning
CUDA_GPU_ID=0
CUDA_BLOCK_SIZE=256
CUDA_GRID_SIZE=65536
CUDA_BATCHES=4096

# Build arch examples:
# RTX 5090 -> try sm_120
# If nvcc too old, use supported arch from your toolkit
